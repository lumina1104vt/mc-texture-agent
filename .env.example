# OpenAI 相容的 LLM server 位址（結尾要有 /v1）
LLM_API_BASE=http://your-llm-server:11434/v1
# server 上的模型名稱（例如 ollama list 顯示的名稱）
LLM_MODEL=your-model-name
# Ollama 不需要 key，留著預設值即可
LLM_API_KEY=not-needed
# 單張材質最多嘗試幾步（重試上限）
MAX_STEPS=16
# 畫完後最多回頭看幾次，0 關閉
REVIEW_ROUNDS=2
# 模型單次輸出上限與請求逾時（秒）；小模型偶爾會無限重複輸出
MAX_OUTPUT_TOKENS=8192
LLM_TIMEOUT=600
